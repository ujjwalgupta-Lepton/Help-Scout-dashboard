# Help Scout API credentials: Your Profile > My Apps > Create My App
HELPSCOUT_APP_ID=
HELPSCOUT_APP_SECRET=

# Individual logins, comma-separated name:password pairs (passwords cannot contain commas).
DASHBOARD_USERS=
# Shared password that works with any username. Leave empty to allow only DASHBOARD_USERS.
# One of the two is required on Vercel; both are optional locally.
DASHBOARD_PASSWORD=

# Time zone used for days and months, e.g. Asia/Kolkata. Defaults to the server's (UTC on Vercel).
DASHBOARD_TIMEZONE=Asia/Kolkata

# How "By company" is worked out:
#   domain   = customer's email domain (fast, no extra API calls)  [default]
#   customer = Company field on the customer's Help Scout profile (one extra call per customer)
COMPANY_SOURCE=domain

# Optional shared cache (Upstash Redis). On Vercel, add Upstash from the Marketplace and these
# (or KV_REST_API_URL / KV_REST_API_TOKEN) are set for you.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Tuning (defaults shown)
CACHE_MINUTES=10
PAST_CACHE_HOURS=6
MAX_CALLS_PER_MINUTE=200
MAX_PAGES=400

# Local server only
PORT=3000
HOST=127.0.0.1
